      "ui-harness",
      "--locked",
      "--no-fail-fast"
    ],
    "exit": 0,
    "label": "ui-tests"
  },
  {
    "command": [
      "cargo",
      "test",
      "-p",
      "deadpan-app",
      "--features",
      "ui-harness",
      "--locked",
      "--no-run",
      "--message-format=json"
    ],
    "exit": 0,
    "label": "ui-inventory"
  },
  {
    "command": [
      "cargo",
      "test",
      "--workspace",
      "--features",
      "deadpan-cli/synthetic-worker",
      "--locked",
