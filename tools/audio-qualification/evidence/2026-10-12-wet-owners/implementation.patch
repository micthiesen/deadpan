diff --git a/crates/deadpan-app/src/preview/harness/wet_returns.rs b/crates/deadpan-app/src/preview/harness/wet_returns.rs
new file mode 100644
index 00000000..e8e356d2
--- /dev/null
+++ b/crates/deadpan-app/src/preview/harness/wet_returns.rs
@@ -0,0 +1,247 @@
+//! Real command routing and durable sends; PCM is checked in deadpan-audio.
+use super::*;
+use deadpan_core::{GainDb, NodeId, TailEffect};
+use egui::{Event, Key, Modifiers};
+
+fn selected(d: &Driver<'_>) -> Result<NodeId, String> {
+    d.app()
+        .selected_beat
+        .clone()
+        .ok_or("No selected beat".into())
+}
+fn level(d: &Driver<'_>, node: &NodeId, effect: TailEffect) -> Option<i32> {
+    d.app()
+        .workspace
+        .as_ref()?
+        .document
+        .nodes()
+        .get(node)?
+        .audio_treatments
+        .wet_sends()
+        .level(effect)
+        .map(GainDb::millidecibels)
+}
+fn edit(d: &mut Driver<'_>, command: &str) -> Result<(), String> {
+    let before = d.revision();
+    d.command(command)?;
+    d.changed(&before)?;
+    d.settled()
+}
+fn undo(d: &mut Driver<'_>) -> Result<(), String> {
+    let before = d.revision();
+    d.key(Key::U)?;
+    d.changed(&before)?;
+    d.settled()
+}
+fn stroke(key: Key, modifiers: Modifiers, text: &str) -> Vec<Event> {
+    vec![
+        key_event(key, modifiers, true),
+        Event::Text(text.into()),
+        key_event(key, modifiers, false),
+    ]
+}
+
+fn visible(d: &Driver<'_>, text: &str) -> bool {
+    scenarios::text_paint_visibility(d, text)
+        .iter()
+        .any(|paint| paint["fully_visible"] == true)
+}
+
+fn inspector_top(d: &mut Driver<'_>, heading: &str) -> Result<(), String> {
+    let point = d.rect(heading)?.center() + egui::vec2(0.0, 120.0);
+    d.events(
+        "Scroll inspector to top",
+        vec![
+            Event::PointerMoved(point),
+            Event::MouseWheel {
+                unit: egui::MouseWheelUnit::Point,
+                delta: egui::vec2(0.0, 2000.0),
+                phase: egui::TouchPhase::Move,
+                modifiers: Modifiers::NONE,
+            },
+        ],
+    )?;
+    for _ in 0..8 {
+        d.step("Settle inspector scroll", false)?;
+    }
+    Ok(())
+}
+
+pub(super) fn run(d: &mut Driver<'_>) -> Result<(), String> {
+    d.report.skipped.push("This offscreen replay verifies commands, persistence and painting. It does not start an audio device; decoded PCM and export checks establish the sound.".into());
+    d.command("sequence")?;
+    super::transcript::focus_your_edit(d)?;
+    d.chord(&[Key::G, Key::G, Key::Num4, Key::Num0, Key::L])?;
+    let before = d.revision();
+    d.key(Key::S)?;
+    d.changed(&before)?;
+    d.settled()?;
+    let right = selected(d)?;
+    let duration = d.app().sequence_length();
+    edit(d, "wet-send delay -6dB")?;
+    edit(d, "wet-send reverb -3dB")?;
+    d.check(
+        "Separate send levels keep picture time and other sends",
+        level(d, &right, TailEffect::Delay) == Some(-6000)
+            && level(d, &right, TailEffect::Reverb) == Some(-3000)
+            && d.app().sequence_length() == duration,
+        json!({"delay":-6000,"reverb":-3000,"duration":duration}),
+        d.snapshot(),
+    )?;
+    inspector_top(d, "Selected beat inspector pane")?;
+    d.step("Paint continuous beat returns", true)?;
+    scenarios::reveal_inspector_button(d, "delay return: -6dB  :wet-send")?;
+    d.check(
+        "The inspector visibly teaches the delay return and its command",
+        visible(d, "delay return: -6dB"),
+        json!("delay return: -6dB"),
+        d.widgets(),
+    )?;
+    d.capture("Continuous beat returns")?;
+    undo(d)?;
+    d.check(
+        "Undo removes only the latest send",
+        level(d, &right, TailEffect::Reverb).is_none()
+            && level(d, &right, TailEffect::Delay) == Some(-6000),
+        json!("delay only"),
+        d.snapshot(),
+    )?;
+    edit(d, "wet-send delay off")?;
+    undo(d)?;
+    edit(d, "wet-send reverb -3dB")?;
+    d.key(Key::K)?;
+    d.settled()?;
+    let left = selected(d)?;
+    let before = d.revision();
+    d.events(
+        "Repeat send with dot",
+        stroke(Key::Period, Modifiers::NONE, "."),
+    )?;
+    d.changed(&before)?;
+    d.settled()?;
+    d.check(
+        "Dot applies the captured send to another beat",
+        left != right && level(d, &left, TailEffect::Reverb) == Some(-3000),
+        json!(-3000),
+        d.snapshot(),
+    )?;
+    undo(d)?;
+    d.key(Key::Q)?;
+    d.key(Key::A)?;
+    edit(d, "wet-send delay -9dB")?;
+    d.key(Key::Q)?;
+    d.wait_for("Save send macro", |app| {
+        !app.service.is_busy() && !app.macros.recording() && !app.macros.is_pending()
+    })?;
+    d.key(Key::J)?;
+    d.settled()?;
+    let before = d.revision();
+    let mut events = stroke(Key::Num2, Modifiers::SHIFT, "@");
+    events.extend(stroke(Key::A, Modifiers::NONE, "a"));
+    d.events("Replay send macro", events)?;
+    d.changed(&before)?;
+    d.settled()?;
+    d.check(
+        "Macro changes the selected send as one edit",
+        selected(d)? == right && level(d, &right, TailEffect::Delay) == Some(-9000),
+        json!(-9000),
+        d.snapshot(),
+    )?;
+    undo(d)?;
+    d.check(
+        "Undo restores the previous send",
+        level(d, &right, TailEffect::Delay) == Some(-6000),
+        json!(-6000),
+        d.snapshot(),
+    )?;
+
+    let capture = d.app().capture_gain_target();
+    let macro_capture = d.app().capture_macro_target();
+    edit(d, "gain -3dB")?;
+    let before = d.revision();
+    d.app_mut().tail_send_command(
+        Some(capture),
+        Some(macro_capture),
+        TailEffect::Delay,
+        Some(GainDb::UNITY),
+        true,
+    );
+    d.settled()?;
+    d.check(
+        "A stale send capture cannot cross a revision",
+        d.revision() == before && d.app().error.is_some(),
+        json!(before),
+        d.snapshot(),
+    )?;
+    d.app_mut()
+        .tail_send_command(None, None, TailEffect::Delay, Some(GainDb::UNITY), true);
+    d.settled()?;
+    d.check(
+        "An absent send capture cannot use a later target",
+        d.revision() == before && d.app().error.is_some(),
+        json!(before),
+        d.snapshot(),
+    )?;
+    undo(d)?;
+
+    edit(d, "wrap-repeat 3")?;
+    d.key(Key::Enter)?;
+    d.command("scope play 2")?;
+    d.settled()?;
+    edit(d, "wet-send delay -12dB")?;
+    let isolated = d.app().scoped_target()?.ok_or("No isolated play")?;
+    d.check(
+        "A selected play isolates its send and preserves the base",
+        level(d, &isolated.target.node, TailEffect::Delay) == Some(-12000)
+            && level(d, &right, TailEffect::Delay) == Some(-6000),
+        json!({"play2":-12000,"base":-6000}),
+        d.snapshot(),
+    )?;
+    undo(d)?;
+    d.command("scope all")?;
+    d.key(Key::Backspace)?;
+    undo(d)?;
+
+    let before = d.revision();
+    d.command("wet-send delay 24.001dB")?;
+    d.check(
+        "Invalid return level cannot commit",
+        d.revision() == before && d.app().error.is_some(),
+        json!(before),
+        d.snapshot(),
+    )?;
+    let saved = level(d, &right, TailEffect::Delay);
+    edit(d, "gain -4dB")?;
+    d.check(
+        "Gain edits preserve continuous returns",
+        level(d, &right, TailEffect::Delay) == saved,
+        json!(saved),
+        d.snapshot(),
+    )?;
+    undo(d)?;
+    d.check(
+        "Returns never add picture time",
+        d.app().sequence_length() == duration,
+        json!(duration),
+        d.snapshot(),
+    )?;
+    let viewport = egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(960.0, 640.0));
+    let input = d.harness.input_mut();
+    input.screen_rect = Some(viewport);
+    input
+        .viewports
+        .get_mut(&egui::ViewportId::ROOT)
+        .ok_or("Missing return viewport")?
+        .inner_rect = Some(viewport);
+    d.step("Resize return inspector", true)?;
+    inspector_top(d, "Selected beat inspector pane")?;
+    scenarios::reveal_inspector_button(d, "delay return: -6dB  :wet-send")?;
+    d.check(
+        "Return control remains readable at minimum size",
+        visible(d, "delay return: -6dB"),
+        json!("readable continuous delay control"),
+        d.widgets(),
+    )?;
+    d.capture("Continuous returns at minimum size")?;
+    Ok(())
+}
diff --git a/crates/deadpan-audio/tests/stages/wet_owners.rs b/crates/deadpan-audio/tests/stages/wet_owners.rs
new file mode 100644
index 00000000..dcbe2c19
--- /dev/null
+++ b/crates/deadpan-audio/tests/stages/wet_owners.rs
@@ -0,0 +1,474 @@
+//! Decoded real PCM through stored owner returns. Oracles compose independently
+//! prepared dry samples and finite kernels, outside the recursive mixer.
+use super::*;
+
+fn base() -> ProjectDocument {
+    let rate = FrameRate::new(48_000, 1).unwrap();
+    let mut body = BeatNode::sequence("Repeated source", vec![]);
+    body.kind = NodeKind::Repeat {
+        child: id("source"),
+        iterations: IterationOrder::new(RevisionId::new("wet-plays").unwrap(), 6).unwrap(),
+        gap: None,
+        escalation: None,
+    };
+    document_with_asset(
+        rate,
+        &["body"],
+        [("body", body), ("source", source(rate, 4800, 0..4800))],
+        BTreeMap::new(),
+        audio(0, 8197).span,
+    )
+}
+
+fn changed(document: &ProjectDocument, node: &str, recipe: AudioTreatments) -> ProjectDocument {
+    let mut wire = serde_json::to_value(document).unwrap();
+    wire["nodes"][node]["audio_treatments"] = serde_json::to_value(recipe).unwrap();
+    ProjectDocument::from_json(&wire.to_string()).unwrap()
+}
+
+fn send(effect: TailEffect, level: i32) -> AudioTreatments {
+    AudioTreatments::default()
+        .with_wet_sends(TailSends::default().with_level(effect, Some(GainDb::new(level).unwrap())))
+}
+
+fn reader(document: &ProjectDocument) -> StageAudio {
+    StageAudio::new(Arc::new(RenderPlan::compile(document).unwrap()))
+}
+
+fn read(
+    reader: &mut StageAudio,
+    provider: &mut FixtureProvider,
+    start: i64,
+    frames: u32,
+) -> Vec<[f32; 2]> {
+    reader
+        .prepare_authored_bus(
+            provider,
+            AudioSample(start),
+            frames,
+            TIMEOUT,
+            &AtomicBool::new(false),
+        )
+        .unwrap()
+        .samples
+}
+
+fn all(document: &ProjectDocument) -> Vec<[f32; 2]> {
+    let mut provider = FixtureProvider::new();
+    provider.revisions.insert(document.revision_id().clone());
+    read(
+        &mut reader(document),
+        &mut provider,
+        0,
+        document.duration().unwrap().frames() as u32,
+    )
+}
+
+fn wet(effect: TailEffect, input: &[[f32; 2]]) -> Vec<[f64; 2]> {
+    let cancel = AtomicBool::new(false);
+    let mut processor = deadpan_audio::FiniteWetEffect::new(effect, &cancel).unwrap();
+    let history = processor.descriptor().history_frames;
+    let width = processor.descriptor().output_frames;
+    let mut output = Vec::new();
+    for start in (0..input.len()).step_by(width) {
+        let mut left = vec![0.0; processor.input_frames()];
+        let mut right = left.clone();
+        for (offset, (left, right)) in left.iter_mut().zip(&mut right).enumerate() {
+            let at = start as i64 - history as i64 + offset as i64;
+            if at >= 0
+                && let Some(frame) = input.get(at as usize)
+            {
+                *left = f64::from(frame[0]);
+                *right = f64::from(frame[1]);
+            }
+        }
+        let mut a = vec![0.0; width];
+        let mut b = a.clone();
+        processor
+            .process_tile(&left, &right, &mut a, &mut b, &cancel)
+            .unwrap();
+        output.extend(
+            a.into_iter()
+                .zip(b)
+                .map(|(a, b)| [a, b])
+                .take(input.len() - start),
+        );
+    }
+    output
+}
+
+#[test]
+fn root_returns_match_dry_plus_finite_wet_and_cold_partitions() {
+    let base = base();
+    let dry = all(&base);
+    for effect in [TailEffect::Reverb, TailEffect::Delay] {
+        let document = changed(&base, "root", send(effect, -6000));
+        let plan = RenderPlan::compile(&document).unwrap();
+        assert!(plan.has_audio_wet_sends());
+        let returned = wet(effect, &dry);
+        let expected: Vec<_> = dry
+            .iter()
+            .zip(returned)
+            .map(|(dry, wet)| {
+                std::array::from_fn(|ch| {
+                    (f64::from(dry[ch]) + wet[ch] * 10f64.powf(-6.0 / 20.0)) as f32
+                })
+            })
+            .collect();
+        let actual = all(&document);
+        assert_pcm_close(&actual, &expected);
+        assert!(
+            actual
+                .iter()
+                .zip(&dry)
+                .any(|(a, b)| (a[0] - b[0]).abs() > 0.001)
+        );
+        for (at, count) in [(14399, 257), (0, 31), (8191, 8193), (28000, 800)] {
+            let cold = read(
+                &mut reader(&document),
+                &mut FixtureProvider::new(),
+                at,
+                count,
+            );
+            assert_pcm_close(&cold, &actual[at as usize..at as usize + count as usize]);
+        }
+    }
+}
+
+#[test]
+fn child_owner_returns_enter_before_parent_saturation() {
+    let base = base();
+    let dry = all(&base);
+    let saturation = Saturation::new(GainDb::new(9000).unwrap()).unwrap();
+    for effect in [TailEffect::Reverb, TailEffect::Delay] {
+        let document = changed(
+            &changed(&base, "body", send(effect, -3000)),
+            "root",
+            AudioTreatments::default()
+                .with_saturation(Some(saturation))
+                .unwrap(),
+        );
+        let returned = wet(effect, &dry);
+        let expected: Vec<_> = dry
+            .iter()
+            .zip(&returned)
+            .map(|(dry, wet)| {
+                std::array::from_fn(|ch| {
+                    saturation.shape(f64::from(dry[ch]) + wet[ch] * 10f64.powf(-3.0 / 20.0)) as f32
+                })
+            })
+            .collect();
+        let wrong: Vec<[f32; 2]> = dry
+            .iter()
+            .zip(&returned)
+            .map(|(dry, wet)| {
+                std::array::from_fn(|ch| {
+                    (saturation.shape(f64::from(dry[ch])) + wet[ch] * 10f64.powf(-3.0 / 20.0))
+                        as f32
+                })
+            })
+            .collect();
+        let actual = all(&document);
+        assert_pcm_close(&actual, &expected);
+        assert!(
+            actual
+                .iter()
+                .zip(wrong)
+                .any(|(a, b)| (a[0] - b[0]).abs() > 0.001)
+        );
+    }
+}
+
+#[test]
+fn silent_hold_suppresses_incoming_root_return_and_resumed_source_keeps_history() {
+    let rate = FrameRate::new(48_000, 1).unwrap();
+    let base = document_with_asset(
+        rate,
+        &["before", "pause", "after"],
+        [
+            ("before", source(rate, 4800, 0..4800)),
+            ("pause", hold(1000)),
+            ("after", source(rate, 4800, 0..4800)),
+        ],
+        BTreeMap::new(),
+        audio(0, 8197).span,
+    );
+    let dry = all(&base);
+    let document = changed(&base, "root", send(TailEffect::Reverb, 0));
+    let returned = wet(TailEffect::Reverb, &dry);
+    let expected: Vec<_> = dry
+        .iter()
+        .zip(returned)
+        .enumerate()
+        .map(|(at, (dry, wet))| {
+            if (4800..5800).contains(&at) {
+                [0.0; 2]
+            } else {
+                std::array::from_fn(|ch| (f64::from(dry[ch]) + wet[ch]) as f32)
+            }
+        })
+        .collect();
+    let actual = all(&document);
+    assert_pcm_close(&actual, &expected);
+    assert!(actual[4800..5800].iter().all(|frame| *frame == [0.0; 2]));
+    let cold = read(
+        &mut reader(&document),
+        &mut FixtureProvider::new(),
