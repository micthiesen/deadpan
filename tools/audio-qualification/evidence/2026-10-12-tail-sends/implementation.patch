+    assert!(
+        renderer
+            .read(&mut provider, AudioSample(9000), 200, TIMEOUT, &cancelled)
+            .is_err()
+    );
+    assert!(cancelled.load(Ordering::Relaxed));
+    cancelled.store(false, Ordering::Relaxed);
+    provider.cancel_on_call = false;
+    let recovered = renderer
+        .read(&mut provider, AudioSample(9000), 200, TIMEOUT, &cancelled)
