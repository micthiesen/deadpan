+    partial_repeat(false, false);
+}
+
+#[test]
+fn partial_repeat_keeps_event_and_shared_equalizer_history() {
+    partial_repeat(true, false);
+}
+
+#[test]
+fn partial_repeat_keeps_complete_nested_preserve_context() {
+    partial_repeat(false, true);
+}
