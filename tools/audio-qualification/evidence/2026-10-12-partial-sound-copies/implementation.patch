+}
+
+#[test]
+fn new_copy_wrapper_equalizer_uses_delivered_sound_as_its_input() {
+    let before = ntsc(AudioEdgePolicy::Hard);
+    let slice = capture_range(&before, "root", 3, 6, "capture-wrapper");
+    let copied = paste_repeat_slice(&before, "root", 3, &slice, "wrapper-copy");
+    let dry = render(&copied, 8, 11);
+    let eq = EqualizerRecipe::new(
+        [6000, -6000, 3000].map(|db| GainDb::new(db).unwrap()),
+        None,
+        None,
+    )
+    .unwrap();
+    let mut filter = deadpan_audio::Equalizer::new(eq, &AtomicBool::new(false)).unwrap();
+    let first = frame_sample_boundary(8);
+    let last = frame_sample_boundary(11);
+    let mut expected = Vec::new();
+    for tile in (first / 1024 * 1024..last).step_by(1024) {
+        let mut left = vec![0.0; 5120];
+        let mut right = vec![0.0; 5120];
+        for index in 0..5120 {
+            let at = tile - 2048 + index as i64;
+            if first <= at && at < last {
+                let frame = dry[(at - first) as usize];
+                left[index] = f64::from(frame[0]);
+                right[index] = f64::from(frame[1]);
+            }
+        }
+        let mut out_left = vec![0.0; 1024];
+        let mut out_right = vec![0.0; 1024];
+        filter
+            .process_tile(
+                &left,
+                &right,
+                &mut out_left,
+                &mut out_right,
+                &AtomicBool::new(false),
+            )
+            .unwrap();
+        for at in tile.max(first)..(tile + 1024).min(last) {
+            expected.push([
+                out_left[(at - tile) as usize] as f32,
+                out_right[(at - tile) as usize] as f32,
+            ]);
+        }
+    }
+    let treated = edit(
+        &copied,
+        "wrapper-eq",
+        Command::SetAudioTreatments {
+            node: id("wrapper-copy-node-0"),
+            treatments: AudioTreatments::default().with_equalizer(Some(eq)).unwrap(),
+        },
+    );
+    compare_copy(&expected, &render(&treated, 8, 11), true, "new wrapper EQ");
+}
+
+#[test]
+fn copied_owner_preparation_keeps_the_terminal_sample_hidden_by_new_rounding() {
+    let before = ntsc(AudioEdgePolicy::Hard);
+    let slice = capture_range(&before, "root", 3, 6, "terminal-capture");
+    let once = paste_repeat_slice(&before, "root", 3, &slice, "terminal-copy");
+    let recopy = capture_range(&once, "terminal-copy-node-0", 9, 11, "terminal-recapture");
+    let twice = paste_repeat_slice(&once, "root", 4, &recopy, "terminal-recopy");
+    let owner = twice
+        .beat_sounds()
+        .keys()
+        .find(|id| id.as_str().starts_with("terminal-recopy"))
+        .unwrap();
+    let expected = super::owner_input::read_input(&before, &id("owner"), 9608, 3);
+    assert_ne!(expected[1], [0.0; 2]);
+    assert_eq!(expected[2], [0.0; 2]);
+    let plan = compile(&twice, false);
+    let context = plan
+        .audio_sound_instance_context(
+            &InstancePath {
+                node: owner.clone(),
+                repeats: vec![],
+            },
+            Default::default(),
+        )
+        .unwrap();
+    assert_eq!(context.samples().end, AudioSample(20821));
+    let mut reader = StageAudio::new(plan.clone());
+    let mut provider = ClockProvider::new(&twice);
+    let read = |reader: &mut StageAudio, provider: &mut ClockProvider| {
+        reader.read_beat_sound_owner_input(
+            provider,
+            &context,
+            AudioSample(20820),
+            3,
+            TIMEOUT,
+            &AtomicBool::new(false),
+        )
+    };
+    assert_eq!(read(&mut reader, &mut provider).unwrap().samples, expected);
+    assert_eq!(read(&mut reader, &mut provider).unwrap().samples, expected);
+    provider.fixture.unavailable = true;
+    assert!(read(&mut reader, &mut provider).is_err());
+}
+
+#[test]
+fn shared_copy_history_preserves_half_sample_ties_after_an_odd_move() {
+    // Three samples per two frames deliberately puts both full-owner edges on
+    // half-sample ties. The selected output moves by minus three sample labels.
+    let rate = FrameRate::new(32_000, 1).unwrap();
+    let base = document(
+        rate,
+        &["lead", "owner", "tail"],
+        [
+            ("lead", picture_only(rate, 1)),
+            ("owner", picture_only(rate, 4)),
+            ("tail", picture_only(rate, 1)),
+        ],
+        BTreeMap::new(),
+    );
+    let mut wire = serde_json::to_value(base).unwrap();
+    wire["assets"]["media"]["source_qualification"] = serde_json::json!("c".repeat(64));
+    let voice = voice_recipe(rate, 6);
+    wire["beat_sounds"] = serde_json::json!({"owner": {"effect": BeatSound {
+        label: "Tiny sound".into(), source: voice.source, mapping: voice.mapping,
+        offset: voice.offset, treatments: AudioTreatments::default(),
+        start_edge: AudioEdgePolicy::Hard, end_edge: AudioEdgePolicy::Hard,
+        overflow: SoundOverflowPolicy::Reject,
+    }}});
+    let eq = EqualizerRecipe::new(
+        [6000, -6000, 3000].map(|v| GainDb::new(v).unwrap()),
+        None,
+        None,
+    )
+    .unwrap();
+    wire["nodes"]["owner"]["audio_treatments"] =
+        serde_json::to_value(AudioTreatments::default().with_equalizer(Some(eq)).unwrap()).unwrap();
+    let before = ProjectDocument::from_json(&wire.to_string()).unwrap();
+    let expected = render(&before, 2, 5);
+    let captured = capture_range(&before, "root", 2, 5, "half-capture");
+    let copied = paste_repeat_slice(&before, "root", 0, &captured, "half-copy");
+    let actual = render(&copied, 0, 3);
+    assert_eq!(expected.len(), 5);
+    assert_eq!(actual.len(), 4);
+    compare_copy(&expected, &actual, true, "half-sample copy");
+}
diff --git a/crates/deadpan-cli/tests/preview_export/partial_sounds.rs b/crates/deadpan-cli/tests/preview_export/partial_sounds.rs
new file mode 100644
index 00000000..ed5d72a3
--- /dev/null
+++ b/crates/deadpan-cli/tests/preview_export/partial_sounds.rs
@@ -0,0 +1,183 @@
+//! Command-created partial attachment copies through the public Render path.
+//! Start from the full Original Source, with its audio moved outside the beat.
+
+use super::*;
+use deadpan_core::{
+    BeatSound, CapturedEditSlice, EqualizerRecipe, MarkId, OccurrenceIdentities,
+    SlicePasteIdentities,
+};
+
+fn boundary(frame: i64) -> Result<i64> {
+    Ok(i64::try_from(
+        ExactRatio::new(i128::from(frame) * 8008, 5)?.round_even()?,
+    )?)
+}
+
+fn pcm(project: &Project, start: i64) -> Result<Vec<[f64; 2]>> {
+    let result = success(&[
+        "inspect-audio",
+        project.path(),
+        "--samples",
+        &start.to_string(),
+        &(start + 256).to_string(),
+        "--limited",
+    ])?;
+    Ok(serde_json::from_value(result["audio"]["samples"].clone())?)
+}
+
+fn same_pcm(expected: &[[f64; 2]], actual: &[[f64; 2]], context: &str) {
+    assert_eq!(expected.len(), 256);
+    assert_eq!(actual.len(), expected.len());
+    assert!(expected.iter().flatten().any(|value| value.abs() > 0.001));
+    for (index, (expected, actual)) in expected.iter().zip(actual).enumerate() {
+        for channel in 0..2 {
+            assert!(actual[channel].is_finite());
+            assert!(
+                (expected[channel] - actual[channel]).abs() < 1e-6,
+                "{context} sample {index} channel {channel}: {} != {}",
+                expected[channel],
+                actual[channel]
+            );
+        }
+    }
+}
+
+fn copy(
+    project: &mut Project,
+    parent: Option<&NodeId>,
+    start: i64,
+    end: i64,
+    capture: &str,
+) -> Result {
+    project.apply(|project, document, revision| {
+        let slice = CapturedEditSlice::capture(
+            document,
+            parent.unwrap_or(document.root()),
+            FrameRange::new(ProjectFrame(start), ProjectFrame(end))?,
+            AudioTimingId {
+                allocation: RevisionId::new(capture)?,
+                ordinal: 0,
+            },
+        )
+        .map_err(|error| format!("capture {start}..{end} ({capture}): {error}"))?;
+        let required = slice.identity_requirements()?;
+        Ok(Command::SpliceSlice {
+            parent: document.root().clone(),
+            index: root_children(document)?.len(),
+            identities: SlicePasteIdentities {
+                authored: OccurrenceIdentities {
+                    nodes: project.fresh(required.nodes)?,
+                    marks: (0..required.marks)
+                        .map(|index| MarkId::new(format!("{revision}-mark-{index}")))
+                        .collect::<std::result::Result<_, _>>()?,
+                },
+                aliases: project.fresh(required.aliases)?,
+            },
+            slice,
+            timing: AudioTimingId {
+                allocation: revision.clone(),
+                ordinal: 0,
+            },
+        })
+    })?;
+    Ok(())
+}
+
+pub fn partial_attached_sound_copies(dir: &Path) -> Result<Fixture> {
+    let mut project = Project::create(dir, "partial-attached-sound-copies")?;
+    place_click_sound(&mut project)?;
+    let owner = root_children(&project.document()?)?[0].clone();
+    project.apply(|_, document, _| {
+        let NodeKind::Source { source } = &document.nodes()[&owner].kind else {
+            return Err("fixture owner is not a Source".into());
+        };
+        Ok(Command::SetSourceAudioMapping {
+            node: owner.clone(),
+            mapping: source.audio_mapping,
+            // Keep the Original's audio outside this allocation so its own
+            // timing and edge policies cannot supply the attachment oracle.
+            offset: AudioSample(480_000),
+        })
+    })?;
+    let eq = EqualizerRecipe::new(
+        [3000, -6000, 3000].map(|db| GainDb::new(db).unwrap()),
+        None,
+        None,
+    )?;
+    project.apply(|_, document, _| {
+        let source = document.sounds()[&SoundId::new("click")?].source.clone();
+        Ok(Command::SetBeatSound {
+            owner: owner.clone(),
+            id: SoundId::new("attached")?,
+            event: BeatSound {
+                label: "Partial copied sound".into(),
+                mapping: SourceAudioMapping::natural_rate(
+                    source.span,
+                    document.presentation_basis().frame_rate,
+                )?,
+                source,
+                offset: AudioSample(0),
+                treatments: AudioTreatments::default()
+                    .with_clip_gain(ClipGain::new(GainDb::new(-12000)?, false, vec![], vec![])?)?
+                    .with_equalizer(Some(eq))?,
+                start_edge: AudioEdgePolicy::Hard,
+                end_edge: AudioEdgePolicy::Hard,
+                overflow: SoundOverflowPolicy::Reject,
+            },
+        })
+    })?;
+    project.apply(|_, _, _| {
+        Ok(Command::DeleteSound {
+            id: SoundId::new("click")?,
+        })
+    })?;
+    project.apply(|_, _, _| {
+        Ok(Command::SetAudioTreatments {
+            node: owner.clone(),
+            treatments: AudioTreatments::default().with_equalizer(Some(eq))?,
+        })
+    })?;
+
+    let first = pcm(&project, boundary(2)? + 512)?;
+    copy(&mut project, None, 2, 6, "partial-export-capture")?;
+    same_pcm(&first, &pcm(&project, boundary(120)? + 512)?, "first paste");
+    let second = pcm(&project, boundary(121)? + 512)?;
+    let copied_group = root_children(&project.document()?)?
+        .last()
+        .ok_or("copied group")?
+        .clone();
+    copy(
+        &mut project,
+        Some(&copied_group),
+        121,
+        124,
+        "partial-export-recapture",
+    )?;
+    same_pcm(&second, &pcm(&project, boundary(124)? + 512)?, "recopy");
+    project.apply(|_, _, revision| {
+        Ok(Command::DeleteRipple {
+            node: owner.clone(),
+            timing: AudioTimingId {
+                allocation: revision.clone(),
+                ordinal: 0,
+            },
+        })
+    })?;
+    same_pcm(&first, &pcm(&project, 512)?, "first after deletion");
+    same_pcm(
+        &second,
+        &pcm(&project, boundary(4)? + 512)?,
+        "recopy after deletion",
+    );
+    assert_eq!(project.document()?.beat_sounds().len(), 2);
+    project.finish(
+        vec!["Partial attached-sound copy and recopy"],
+        (0..4)
+            .map(|frame| (frame, original(frame + 2)))
+            .chain((4..7).map(|frame| (frame, original(frame - 1))))
+            .collect(),
+        vec![
+            "Real registered stereo WAV with event and shared-owner EQ; partial copy 2..6, recopy 121..124, delete original owner. Independent pre-copy PCM windows match after both pastes and deletion within 1e-6.".into(),
+        ],
+    )
+}
