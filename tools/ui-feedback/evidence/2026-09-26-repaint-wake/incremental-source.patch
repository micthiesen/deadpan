+        }
+        assert!(wake.state.lock().unwrap().next().is_none());
+        let producer = context.clone();
+        let thread = std::thread::spawn(move || producer.request_repaint());
+        assert!(wake.wait_until(Instant::now() + Duration::from_secs(5)));
+        thread.join().unwrap();
+    }
