+    fn reuse_wide_document(count: usize) -> ProjectDocument {
+        let mut document = ProjectDocument::new(
+            ProjectId::new("reuse-wide").unwrap(),
+            RevisionId::new("initial").unwrap(),
+            PresentationBasis {
+                width: 16,
+                height: 16,
+                frame_rate: FrameRate::new(24, 1).unwrap(),
+                color_policy: ColorPolicy::SdrRec709,
+            },
+            reuse_id("root"),
+        ).unwrap();
+        let children: Vec<_> = (0..count).map(|index| {
+            let id = reuse_id(&format!("hold-{index:05}"));
+            document.nodes.insert(id.clone(), hold(4));
+            id
+        }).collect();
+        document.nodes.insert(reuse_id("root"), BeatNode::sequence("Root", children));
+        document.validate().unwrap();
+        document
+    }
