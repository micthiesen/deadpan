+    fn compact_document() -> ProjectDocument {
+        ProjectDocument::new(
+            ProjectId::new("compact-size").unwrap(),
+            RevisionId::new("initial").unwrap(),
+            PresentationBasis {
+                width: 1920,
+                height: 1080,
+                frame_rate: FrameRate::new(24, 1).unwrap(),
