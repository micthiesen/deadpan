+        self.edges = self
+            .edges
+            .checked_add(1)
+            .ok_or(PlanError::AudioQueryLimit("projected Preserve edges"))?;
+        if self.edges > MAX_PROJECTION_EDGES {
+            return Err(PlanError::AudioQueryLimit("projected Preserve edges"));
+        }
+        Ok(())
+    }
+}
