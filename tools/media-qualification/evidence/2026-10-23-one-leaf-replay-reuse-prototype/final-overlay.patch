+    // damaging its receipt. The candidate's immutable entry stays identical.
+    store.preview_compound(request)?;
+    let database = Connection::open(path.join("project.sqlite"))?;
+    assert_eq!(
+        database.execute(
+            "DELETE FROM source_qualifications WHERE id=?1",
