+def validate_audio_evidence(verification, samples):
+    """Apply the verifier's unshifted block and observable-offset policy.
+
+    Source: export_verification/audio_check.rs and metrics.rs. A periodic
+    segment does not establish an offset. At least one unique zero witness
+    remains mandatory; no offset or uncorrelated segment is accepted.
+    """
+    thresholds = verification['thresholds']
+    expected = {'silence_dbfs': -70.0, 'silent_max_peak_dbfs': -50.0,
+                'silent_block_max_dbfs': -60.0, 'block_floor_dbfs': -60.0,
+                'min_block_snr_db': 1.5, 'max_block_level_db': 3.0,
+                'min_alignment_correlation': 0.5}
+    assert all(thresholds[key] == value for key, value in expected.items())
+    audio, = verification['audio']
+    assert audio['kind'] == 'signal' and not audio['flags'] and audio['passed']
+    assert audio['window'] == audio['project_samples'] == [0, samples]
+    assert audio['uncovered_samples'] == 0
+    assert audio['offset_status'] == 'verified_zero' and audio['measured_offset_samples'] == 0
+    blocks = audio['blocks']
+    # The complete fixture has continuous signal; every 480-sample block,
+    # including the short terminal block, must receive content or silence gates.
+    assert blocks['compared'] > 0
+    assert blocks['compared'] + blocks['silent'] == (samples + 479) // 480
+    assert blocks['low_snr_blocks'] == blocks['level_blocks'] == blocks['sound_in_silence_blocks'] == 0
+    assert math.isfinite(blocks['min_snr_db']) and blocks['min_snr_db'] >= thresholds['min_block_snr_db']
+    assert math.isfinite(blocks['max_level_difference_db']) and blocks['max_level_difference_db'] <= thresholds['max_block_level_db']
+    segments = audio['segments']
+    assert 0 < len(segments) <= 8
+    assert len({row['segment_start'] for row in segments}) == len(segments)
+    identifiable = []
+    periodic = []
+    for row in segments:
+        assert 0 <= row['segment_start'] < samples
+        assert 0 < row['segment_samples'] <= 4096
+        assert row['segment_start'] + row['segment_samples'] <= samples
+        assert abs(row['peak_lag']) <= 2048
+        peak, zero = row['peak_correlation'], row['zero_lag_correlation']
+        assert math.isfinite(peak) and math.isfinite(zero)
+        assert peak >= thresholds['min_alignment_correlation']
+        if row['status'] == 'verified_zero':
+            assert row['peak_lag'] == 0 and zero == peak
+            secondary = row['secondary_correlation']
+            assert secondary is None or secondary < peak - 1e-3
+            identifiable.append(row['segment_start'])
+        else:
+            assert row['status'] == 'periodic'
+            secondary = row['secondary_correlation']
+            assert secondary is not None and math.isfinite(secondary)
+            assert row['secondary_lag'] is not None and abs(row['secondary_lag']) <= 2048
+            assert abs(row['secondary_lag'] - row['peak_lag']) >= 32
+            # These are the existing correlation-periodicity tests, not a
+            # time-offset tolerance. A nonzero periodic peak is not called zero.
+            assert secondary >= peak - 1e-3 and zero >= peak - 1e-3
+            periodic.append({'start': row['segment_start'], 'peak_lag': row['peak_lag']})
+    assert identifiable, 'Purely periodic audio cannot establish zero offset'
+    summary = verification['summary']
+    assert summary['signal_windows'] == summary['offset_verified_windows'] == 1
+    assert summary['offset_unobservable_windows'] == 0
+    assert summary['nonzero_offsets'] == summary['audio_windows_failed'] == 0
+    assert summary['blocks_compared'] == blocks['compared']
+    return {'identifiable_zero_segment_starts': identifiable,
+            'periodic_segments_unobservable_individually': periodic,
+            'unshifted_blocks_compared': blocks['compared'],
+            'unshifted_blocks_silent': blocks['silent']}
 
 
