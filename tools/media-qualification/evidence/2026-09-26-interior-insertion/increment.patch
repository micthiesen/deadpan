+                    child: child.clone(),
+                    duration: *duration,
+                    mapping: *mapping,
+                    pitch: *pitch,
+                    purpose: match purpose {
+                        RetimePurpose::Edit => LegacyRetimePurpose::Edit,
+                        RetimePurpose::Partition => LegacyRetimePurpose::Partition,
+                    },
+                },
+            },
+        })
+    }
+}
