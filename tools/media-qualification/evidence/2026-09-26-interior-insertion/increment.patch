+        }
+        OldCommand::AddAsset { id, asset } => Command::AddAsset { id, asset },
+        OldCommand::ImportSource {
+            id,
+            asset,
+            insertion,
+            primary,
+        } => Command::ImportSource {
+            id,
+            asset,
