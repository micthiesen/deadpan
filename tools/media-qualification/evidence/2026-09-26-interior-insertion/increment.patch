+            },
+        )
+        .unwrap();
+        let transaction = apply(
+            &document,
+            &CommandRequest {
+                project_id: document.project_id().clone(),
+                expected_revision: document.revision_id().clone(),
+                new_revision: revision("interior-pause"),
+                command: Command::InsertTime {
+                    at: ProjectFrame(2),
+                    hold: HoldRecipe {
+                        duration: duration(3),
+                        video: HoldVideo::Freeze {
