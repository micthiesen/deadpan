+                        root: AudioClockRoot::ProjectRootRoundEven,
+                        physical: id("inner"),
+                    },
+                },
+            },
+        )]),
+    )
+    .unwrap();
+    let mut wire = serde_json::to_value(&old).unwrap();
+    wire["nodes"]["outer"] = serde_json::to_value(retime(
+        "inner",
