+pub fn follow_scale_label(scale: ExactRatio, transition: Option<deadpan_core::FollowScaleTransition>) -> String {
+    let Some(transition) = transition else { return scale_label(scale); };
+    match scale.checked_mul(transition.factor) {
+        Ok(end) => format!("{} → {} ({})", scale_label(scale), scale_label(end), match transition.curve {
+            ZoomCurve::Step => "step", ZoomCurve::Linear => "linear", ZoomCurve::Smoothstep => "smoothstep",
+        }),
+        Err(_) => "invalid scale animation".into(),
+    }
+}
