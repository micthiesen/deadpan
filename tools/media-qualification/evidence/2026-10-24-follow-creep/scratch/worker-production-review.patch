+#[cfg(test)]
+mod follow_transition_tests {
+    use super::*;
+    use crate::framing_zoom::ZoomCurve;
+
+    fn ratio(n: i128, d: i128) -> ExactRatio { ExactRatio::new(n, d).unwrap() }
+    fn framing(curve: ZoomCurve) -> Framing {
+        Framing {
+            clock: FramingClock::OwnerOutput,
+            value: FramingValue::Follow {
+                target: crate::TargetId::new("speaker").unwrap(),
+                scale: ratio(2, 1),
+                fallback: FramingPose::new(ratio(1, 3), ratio(2, 7), ratio(1, 2)).unwrap(),
+                scale_transition: Some(FollowScaleTransition { factor: ratio(2, 1), curve }),
+            },
+        }
+    }
+
+    #[test]
+    fn follow_transition_curves_preserve_exact_fallback_centers_and_endpoint_scales() {
+        for (curve, live, fallback) in [
+            (ZoomCurve::Step, ratio(2, 1), ratio(1, 2)),
+            (ZoomCurve::Linear, ratio(5, 2), ratio(5, 8)),
+            (ZoomCurve::Smoothstep, ratio(37, 16), ratio(37, 64)),
+        ] {
+            let recipe = framing(curve);
+            let value = recipe.evaluate_with_follow_exact(ratio(1, 1), ratio(4, 1)).unwrap();
+            assert_eq!(value.follow.unwrap().1, live);
+            assert_eq!(value.pose.scale, fallback);
+            assert_eq!(value.pose.center_x, ratio(1, 3));
+            assert_eq!(value.pose.center_y, ratio(2, 7));
+            assert_eq!(recipe.evaluate_exact(ratio(1, 1), ratio(4, 1)).unwrap(), value.pose);
+            assert_eq!(recipe.evaluate_with_follow_exact(ratio(4, 1), ratio(4, 1))
+                .unwrap().follow.unwrap().1, ratio(4, 1));
+        }
+        let mut recipe = framing(ZoomCurve::Linear);
+        if let FramingValue::Follow { scale, fallback, .. } = &mut recipe.value {
+            *scale = ratio(3, 5);
+            fallback.scale = ratio(5, 7);
+        }
+        for local in [ExactRatio::ZERO, ExactRatio::ONE] {
+            let value = recipe.evaluate_with_follow_exact(local, ExactRatio::ONE).unwrap();
+            assert_eq!(value.follow.unwrap().1, if local == ExactRatio::ZERO { ratio(3, 5) } else { ratio(6, 5) });
+            assert_eq!(value.pose.scale, if local == ExactRatio::ZERO { ratio(5, 7) } else { ratio(10, 7) });
+        }
+    }
+
+    #[test]
+    fn follow_transition_retained_fractional_clock_and_growth_keep_original_samples() {
+        let recipe = framing(ZoomCurve::Smoothstep);
+        let grown = recipe.prepend_owner_frames(FrameDuration::new(3).unwrap(), FrameDuration::new(8).unwrap()).unwrap();
+        for n in 0..=16 {
+            let local = ratio(n, 2);
+            let before = recipe.evaluate_with_follow_exact(local, ratio(8, 1)).unwrap();
+            let after = grown.evaluate_with_follow_exact(local.checked_add(ratio(3, 1)).unwrap(), ratio(13, 1)).unwrap();
+            assert_eq!(before.pose, after.pose);
+            assert_eq!(before.follow, after.follow);
+        }
+        assert_eq!(grown.evaluate_exact(ExactRatio::ZERO, ratio(13, 1)).unwrap(),
+            recipe.evaluate_exact(ExactRatio::ZERO, ratio(8, 1)).unwrap());
+        assert_eq!(grown.evaluate_exact(ratio(13, 1), ratio(13, 1)).unwrap(),
+            recipe.evaluate_exact(ratio(8, 1), ratio(8, 1)).unwrap());
+        let mut fractional = recipe.clone();
+        fractional.clock = FramingClock::RetainedOutput { offset: ratio(1, 3), duration: ratio(8, 3) };
+        assert_eq!(fractional.evaluate_exact(ratio(1, 3), ratio(1, 1)).unwrap(),
+            recipe.evaluate_exact(ratio(1, 1), ratio(4, 1)).unwrap());
+    }
+
+    #[test]
+    fn follow_transition_typed_aggregate_admission_uses_the_real_record_limit() {
+        let mut node = crate::BeatNode::sequence("Follow owner", Vec::new());
+        node.framing = Some(framing(ZoomCurve::Linear));
+        assert_eq!(validate_nodes(std::iter::repeat_n(&node, MAX_FRAMING_RECORDS / 2)).unwrap(),
+            MAX_FRAMING_RECORDS);
+        assert!(validate_nodes(std::iter::repeat_n(&node, MAX_FRAMING_RECORDS / 2 + 1)).is_err());
+        if let Some(Framing { value: FramingValue::Follow { scale_transition, .. }, .. }) = &mut node.framing {
+            *scale_transition = None;
+        }
+        assert_eq!(validate_nodes(std::iter::repeat_n(&node, MAX_FRAMING_RECORDS)).unwrap(),
+            MAX_FRAMING_RECORDS);
+        assert!(validate_nodes(std::iter::repeat_n(&node, MAX_FRAMING_RECORDS + 1)).is_err());
+    }
+
+    #[test]
+    fn follow_transition_validates_both_branches_and_closed_raw_vocabulary() {
+        let mut recipe = framing(ZoomCurve::Linear);
+        for bad in [ratio(0, 1), ratio(-1, 1), ratio(128, 1), ratio(1, 128)] {
+            if let FramingValue::Follow { scale_transition, .. } = &mut recipe.value {
+                scale_transition.as_mut().unwrap().factor = bad;
+            }
+            assert!(recipe.validate().is_err());
+        }
+        recipe = framing(ZoomCurve::Linear);
+        if let FramingValue::Follow { fallback, .. } = &mut recipe.value { fallback.scale = ratio(40, 1); }
+        assert!(recipe.validate().is_err(), "fallback endpoint bounds are independent of live scale");
+        let factor = serde_json::to_string(&ratio(2, 1)).unwrap();
+        for (transition, reason) in [
+            (format!(r#"{{"factor":{factor},"curve":"cubic"}}"#), "unknown variant"),
+            (format!(r#"{{"factor":{factor},"factor":{factor},"curve":"linear"}}"#), "duplicate field"),
+            (format!(r#"{{"factor":{factor},"curve":"linear","segments":[]}}"#), "unknown field"),
+        ] {
+            let error = serde_json::from_str::<FollowScaleTransition>(&transition).unwrap_err();
+            assert!(error.to_string().contains(reason), "{error}");
+        }
+        let mut fixed = framing(ZoomCurve::Linear);
+        if let FramingValue::Follow { scale_transition, .. } = &mut fixed.value { *scale_transition = None; }
+        let encoded = serde_json::to_value(&fixed).unwrap();
+        assert!(encoded["value"].get("scale_transition").is_none());
+        assert_eq!(fixed.record_count(), 1);
+        assert_eq!(framing(ZoomCurve::Linear).record_count(), 2);
+        assert_eq!(serde_json::from_value::<Framing>(encoded).unwrap(), fixed);
+    }
+}
