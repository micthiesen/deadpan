    let units = f64::from(TARGET_UNITS);
    let scale = |value: f64, minimum: u32| -> u32 {
        (value * units).round().clamp(f64::from(minimum), units) as u32
    };
    let (x, y) = rect.center();
    TargetRegion {
        center: [scale(x, 0), scale(y, 0)],
        size: [scale(rect.width(), 1), scale(rect.height(), 1)],
    }
}]]><calls total="1"><c n="round" l="135">pub fn round(value: f64) -&gt; f64</c></calls></b><b t="fn" l="1198" p="./crates/deadpan-cli/src/tracking.rs" n="target_rect_at"><![CDATA[pub fn target_rect_at(target: &AttentionTarget, at: i64) -> Option<NormalizedRect> {
    let (region, _) = target.region_at(deadpan_core::SourcePoint {
        ticks: deadpan_core::ExactRatio::integer(at),
        time_base: target.span.start().time_base,
    })?;
    rect_from_target(&region)
}]]><calls total="3"><c n="rect_from_target" l="60">pub fn rect_from_target(region: &amp;TargetRegion) -&gt; Option&lt;NormalizedRect&gt;</c><c n="integer" l="62">pub const fn integer(value: i64) -&gt; Self</c><c n="region_at" l="388">pub fn region_at(&amp;self, point: SourcePoint) -&gt; Option&lt;(TargetRegion, TargetSource)&gt;</c></calls></b><b t="cls" l="164" p="./crates/deadpan-core/src/target.rs" n="TargetSample"><![CDATA[pub struct TargetSample {
