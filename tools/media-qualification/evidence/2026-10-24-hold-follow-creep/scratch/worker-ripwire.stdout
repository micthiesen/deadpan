ode/deadpan/crates/deadpan-core/src/framing_zoom.rs"><d l="112" n="Shot" cx="0" ccx="0" in="0" churn="2">pub struct Shot&lt;&apos;a&gt;</d></f></sigs><bodies shown="3" total="6" capped="1"><b t="fn" l="503" p="/Users/michael/Code/deadpan/crates/deadpan-core/src/framing_zoom/tests.rs" n="follow_creep_keeps_both_bases_and_requires_a_whole_ordinary_source"><![CDATA[fn follow_creep_keeps_both_bases_and_requires_a_whole_ordinary_source() {
    let fallback = FramingPose::new(ratio(1, 3), ratio(2, 7), ratio(1, 2)).unwrap();
    let entry = Framing {
        clock: FramingClock::RetainedOutput {
            offset: ratio(-2, 1),
            duration: ratio(7, 1),
        },
        value: FramingValue::Follow {
            target: TargetId::new("speaker").unwrap(),
            scale: ratio(2, 1),
            fallback,
            scale_transition: None,
        },
    };
    let kind = ZoomKind::Creep {
        from: None,
        to: ratio(4, 1),
        curve: ZoomCurve::Linear,
    };
    let admitted = Shot {
        entry: Some(&entry),
        ordinary_source: true,
        ..shot(None)
    };
    let result = build(kind, &Center::Keep, &admitted).unwrap().unwrap();
    assert_eq!(result.clock, FramingClock::OwnerOutput);
    let value = result
        .evaluate_with_follow_exact(ratio(1, 1), ratio(4, 1))
        .unwrap();
    assert_eq!(value.follow.unwrap().1, ratio(5, 2));
    assert_eq!(value.pose.scale, ratio(5, 8));
    assert_eq!(
        [value.pose.center_x, value.pose.center_y],
        [ratio(1, 3), ratio(2, 7)]
    );
    let explicit = build(
        ZoomKind::Creep {
            from: Some(ratio(3, 1)),
            to: ratio(4, 1),
            curve: ZoomCurve::Linear,
        },
        &Center::Keep,
        &admitted,
    )
    .unwrap()
    .unwrap();
    let initial = explicit
        .evaluate_with_follow_exact(ExactRatio::ZERO, ratio(4, 1))
        .unwrap();
    assert_eq!(initial.follow.unwrap().1, ratio(3, 1));
    assert_eq!(initial.pose.scale, ratio(3, 4));
    for range in [Some((0, 10)), Some((1, 9))] {
        assert!(build(kind, &Center::Keep, &Shot { range, ..admitted }).is_err());
    }
    assert!(
        build(
            kind,
            &Center::Keep,
            &Shot {
                ordinary_source: false,
                ..admitted
            }
        )
        .is_err()
    );
    assert!(
        build(
            kind,
            &Center::Keep,
            &Shot {
                entry: Some(&result),
                ..admitted
            }
        )
        .is_err()
    );
    assert!(
        build(
            ZoomKind::Smash { scale: ratio(3, 1) },
            &Center::Keep,
            &Shot {
                entry: Some(&result),
                ..admitted
            }
        )
        .is_err()
    );
    // Explicit target selection continues to author a sampled ordinary path.
    assert!(matches!(
        build(
            kind,
            &Center::Point([ratio(1, 2), ratio(1, 2)]),
            &Shot {
                explicit: true,
                entry: Some(&result),
                ..admitted
            }
        )
        .unwrap()
        .unwrap()
        .value,
        FramingValue::Envelope { .. }
    ));
}]]><calls total="4"><c n="new" l="76">pub fn new( center_x: ExactRatio, center_y: ExactRatio, scale: ExactRatio, ) -&gt; Result&lt;Self, FramingError&gt;</c><c n="evaluate_with_follow_exact" l="427">pub fn evaluate_with_follow_exact( &amp;self, local: ExactRatio, duration: ExactRatio, ) -&gt; Result&lt;EvaluatedFraming&lt;&apos;_&gt;, FramingError&gt;</c><c n="ratio" l="3">fn ratio(n: i128, d: i128) -&gt; ExactRatio</c><c n="shot" l="103">fn shot(range: Option&lt;(u64, u64)&gt;) -&gt; Shot&lt;&apos;static&gt;</c></calls></b><b t="fn" l="309" p="/Users/michael/Code/deadpan/crates/deadpan-core/src/framing_zoom/tests.rs" n="whole_beat_keep_retains_a_follow_and_refuses_to_flatten_a_path"><![CDATA[fn whole_beat_keep_retains_a_follow_and_refuses_to_flatten_a_path() {
    let id = TargetId::new("target-1").unwrap();
    let fallback = FramingPose::new(ratio(2, 5), ratio(1, 2), ratio(11, 10)).unwrap();
    let follow = Framing {
        clock: FramingClock::RetainedOutput {
            offset: ExactRatio::ONE,
            duration: ExactRatio::integer(12),
        },
        value: FramingValue::Follow {
            target: id.clone(),
            scale: ratio(11, 10),
            fallback,
            scale_transition: None,
        },
    };
    // The displayed pose is the target's center, not the fallback.
    let current = FramingPose::new(ratio(3, 5), ratio(1, 2), ratio(11, 10)).unwrap();
    let shot_on = |entry| Shot {
        entry: Some(entry),
        current,
        ..shot(None)
    };
    let smash = build(
        ZoomKind::Smash { scale: ratio(2, 1) },
        &Center::Keep,
        &shot_on(&follow),
    )
    .unwrap()
    .unwrap();
    assert_eq!(smash.clock, follow.clock);
    assert_eq!(
        smash.value,
        FramingValue::Follow {
            target: id,
            scale: ratio(2, 1),
            fallback: FramingPose {
                scale: ratio(2, 1),
                ..fallback
            },
            scale_transition: None,
        }
    );
    let creep = ZoomKind::Creep {
        from: None,
        to: ratio(2, 1),
        curve: ZoomCurve::Smoothstep,
    };
    assert_eq!(
        build(creep, &Center::Keep, &shot_on(&follow)).unwrap_err(),
        FOLLOW_CREEP_REFUSAL
    );
    // An explicit fixed center replaces the follow on request.
    assert!(matches!(
        build(
            creep,
            &Center::Point([ratio(1, 2), ratio(1, 2)]),
            &Shot {
                explicit: true,
                ..shot_on(&follow)
            }
        ),
        Ok(Some(Framing {
            value: FramingValue::Envelope { .. },
            ..
        }))
    ));
    let path = Framing::creep(
        FramingPose::identity(),
        FramingPose {
            scale: ratio(2, 1),
            ..FramingPose::identity()
        },
        FramingCurve::Smoothstep,
    )
    .unwrap();
    for kind in [ZoomKind::Smash { scale: ratio(3, 2) }, creep] {
        assert_eq!(
            build(kind, &Center::Keep, &shot_on(&path)).unwrap_err(),
            PATH_REFUSAL
        );
        // ,z resolving the selected target is not an explicit replacement.
        let target = Center::Target {
            id: TargetId::new("target-1").unwrap(),
            fixed: Some([ratio(1, 2), ratio(1, 2)]),
        };
        assert_eq!(
            build(kind, &target, &shot_on(&path)).unwrap_err(),
            PATH_REFUSAL
        );
        assert!(
            build(
                kind,
                &target,
                &Shot {
                    explicit: true,
                    ..shot_on(&path)
                }
            )
            .is_ok()
        );
    }
    assert_eq!(
        build(ZoomKind::Off, &Center::Keep, &shot_on(&path)).unwrap(),
        None
    );
}]]><calls total="6"><c n="integer" l="62">pub const fn integer(value: i64) -&gt; Self</c><c n="identity" l="68">pub fn identity() -&gt; Self</c><c n="new" l="76">pub fn new( center_x: ExactRatio, center_y: ExactRatio, scale: ExactRatio, ) -&gt; Result&lt;Self, FramingError&gt;</c><c n="creep" l="277">pub fn creep( from: FramingPose, to: FramingPose, curve: FramingCurve, ) -&gt; Result&lt;Self, FramingError&gt;</c><c n="ratio" l="3">fn ratio(n: i128, d: i128) -&gt; ExactRatio</c><c n="shot" l="103">fn shot(range: Option&lt;(u64, u64)&gt;) -&gt; Shot&lt;&apos;static&gt;</c></calls></b><b t="fn" l="268" p="/Users/michael/Code/deadpan/crates/deadpan-core/src/framing_zoom/tests.rs" n="abrupt_return_steps_out_over_a_range_and_never_flattens_a_path"><![CDATA[fn abrupt_return_steps_out_over_a_range_and_never_flattens_a_path() {
    let zoomed =
        Framing::static_pose(FramingPose::new(ratio(2, 5), ratio(1, 2), ratio(3, 2)).unwrap())
            .unwrap();
    let shot = Shot {
        ordinary_source: false,
        entry: Some(&zoomed),
        current: FramingPose::new(ratio(2, 5), ratio(1, 2), ratio(3, 2)).unwrap(),
        frames: 10,
        range: Some((6, 10)),
        explicit: false,
    };
    let returned = build(ZoomKind::Off, &Center::Keep, &shot).unwrap();
    assert_eq!(evaluate(&returned, 5).scale, ratio(3, 2));
    assert_eq!(evaluate(&returned, 6), FramingPose::identity());
    assert_eq!(evaluate(&returned, 9), FramingPose::identity());
    let path = Framing::creep(
        FramingPose::identity(),
        FramingPose {
            scale: ratio(2, 1),
            ..FramingPose::identity()
        },
        FramingCurve::Smoothstep,
    )
    .unwrap();
    let shot = Shot {
        entry: Some(&path),
        ..shot
    };
    assert!(build(ZoomKind::Off, &Center::Keep, &shot).is_err());
    assert!(build(ZoomKind::Smash { scale: ratio(2, 1) }, &Center::Keep, &shot).is_err());
    // An unframed beat stepping out over a range is unchanged.
    let shot = Shot {
        entry: None,
        current: FramingPose::identity(),
        ..shot
    };
    assert_eq!(build(ZoomKind::Off, &Center::Keep, &shot).unwrap(), None);
}]]><calls total="5"><c n="identity" l="68">pub fn identity() -&gt; Self</c><c n="new" l="76">pub fn new( center_x: ExactRatio, center_y: ExactRatio, scale: ExactRatio, ) -&gt; Result&lt;Self, FramingError&gt;</c><c n="static_pose" l="268">pub fn static_pose(pose: FramingPose) -&gt; Result&lt;Self, FramingError&gt;</c><c n="creep" l="277">pub fn creep( from: FramingPose, to: FramingPose, curve: FramingCurve, ) -&gt; Result&lt;Self, FramingError&gt;</c><c n="ratio" l="3">fn ratio(n: i128, d: i128) -&gt; ExactRatio</c></calls></b><!-- body omitted (over budget): validate_scoped_context --><!-- body omitted (over budget): zoom --><!-- body omitted (over budget): zoom_scoped --></bodies></ctx>