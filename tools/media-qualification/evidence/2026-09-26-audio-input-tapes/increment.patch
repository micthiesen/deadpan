+    let tape = AudioSignalTape::new(
+        &plan,
+        ExactRatio::ZERO..ratio(2048, 1),
+        vec![
+            run(
+                ExactRatio::ZERO..ratio(700, 1),
+                ExactRatio::ZERO..ratio(699, 1),
+                signal.clone(),
+            ),
+            run(
+                ratio(700, 1)..ratio(2048, 1),
+                ratio(699, 1)..ratio(2048, 1),
