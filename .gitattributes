* text=auto
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.pdf binary
*.bin binary
*.yuv420p binary
*.yuv420p10le binary
# Preserve captured output and unified-diff context bytes, including whitespace.
tools/**/evidence/**/*.log -whitespace
tools/**/evidence/**/*.patch -whitespace
tools/**/evidence/**/*.diff -whitespace
# Raw process streams retain their exact bytes, including terminal newlines.
tools/**/evidence/**/*.stdout -text -whitespace
tools/**/evidence/**/*.stderr -text -whitespace
# Upstream notice texts stay byte-identical to their pinned sources.
packaging/notices/** -text
